NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org
NEXT_PUBLIC_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: a valid Stellar public key shown as the dashboard treasury wallet.
# Leave empty to hide the treasury wallet and its copy action.
NEXT_PUBLIC_TREASURY_WALLET=

YELLOWCARD_API_URL=https://api.yellowcard.io
YELLOWCARD_API_KEY=your-yellowcard-sandbox-api-key

# Postgres connection string used by @AfriWage/db (Drizzle).
# Provision a Vercel Postgres / Neon store and paste its connection string here.
# Required for `pnpm --filter @AfriWage/db migrate` and any server route that reads/writes settings.
POSTGRES_URL=postgres://user:password@host:5432/dbname

# Sentry error tracking (optional — error reporting is a no-op when unset).
# Get a DSN from https://sentry.io → Project Settings → Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# Server-side DSN (falls back to NEXT_PUBLIC_SENTRY_DSN when unset)
SENTRY_DSN=
# Auth token for source-map uploads during build (sentry.io → Settings → Auth Tokens)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- SEP-10 wallet authentication ---
# Stellar secret key the server signs SEP-10 challenge transactions with.
# It is the challenge source account only: it never holds funds and never signs
# a value-moving transaction. Generate one with `stellar keys generate`.
AUTH_SERVER_SIGNING_KEY=SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# HMAC secret for the HS256 session JWT (minimum 32 characters).
# Generate one with `openssl rand -hex 32`.
JWT_SECRET=change-me-to-at-least-32-random-characters
# AfriWage's own home domain, bound into the SEP-10 challenge. Bare host only —
# no scheme, no path. Use localhost:3000 in development.
NEXT_PUBLIC_AUTH_HOME_DOMAIN=localhost:3000

# --- Charter treasury (Soroban) ---
# See docs/charter-treasury.md for what each of these authorises.
# Charter factory that deploys per-organization treasuries (testnet deployment).
CHARTER_FACTORY_CONTRACT_ID=CCUQBFFRGR4RUWHKLWSRWKBL3WORHNTHFLTKMHTNUZL4T5733ODN5WD4
# Secret key of the factory's registered `deployer`. Charter's factory is
# permissioned, so this key co-signs treasury deployments. It is NOT a treasury
# signer: it cannot submit, approve or execute a payout.
CHARTER_FACTORY_DEPLOYER_SECRET_KEY=SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Stellar Asset Contract address for USDC — the contract-id form of the asset,
# not the issuer account.
CHARTER_TREASURY_TOKEN_CONTRACT_ID=CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Soroban RPC. Optional — defaults to the public testnet RPC when unset.
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# Charter indexer read API (https://github.com/Ch-rter/app, indexer/). Optional —
# when unset, category and request reads go straight to the contract instead.
CHARTER_INDEXER_API_URL=http://localhost:8080
