NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org
NEXT_PUBLIC_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: a valid Stellar public key shown as the dashboard treasury wallet.
# Leave empty to hide the treasury wallet and its copy action.
NEXT_PUBLIC_TREASURY_WALLET=

YELLOWCARD_API_URL=https://api.yellowcard.io
YELLOWCARD_API_KEY=your-yellowcard-sandbox-api-key

# Postgres connection string used by @AfriWage/db (Drizzle).
# Provision a Vercel Postgres / Neon store and paste its connection string here.
# Required for `pnpm --filter @AfriWage/db migrate` and any server route that reads/writes settings.
POSTGRES_URL=postgres://user:password@host:5432/dbname

# Sentry error tracking (optional — error reporting is a no-op when unset).
# Get a DSN from https://sentry.io → Project Settings → Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# Server-side DSN (falls back to NEXT_PUBLIC_SENTRY_DSN when unset)
SENTRY_DSN=
# Auth token for source-map uploads during build (sentry.io → Settings → Auth Tokens)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
